{
  "name": "dsh-lifecycle",
  "version": "0.1.10",
  "description": "安装后请立即刷新页面进入登录/首次设置；旧页面显示无法连接或 HTTP 401 不代表安装失败。DeepSeek Harness Web 锁屏、持久登录及电源管理，Windows 支持页面一键启用后台服务。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./dist/client.js",
    "./power": "./dist/host.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "types",
    "dist",
    "cordis.patch.yml",
    "scripts/install-systemd.mjs",
    "scripts/install-launchd.mjs",
    "scripts/install-windows.mjs",
    "README.md",
    "docs",
    "LICENSE",
    "UPSTREAM-LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "scripts/reset.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js tests/lib/*.test.js tests/host/*.test.js tests/supervisor/*.test.js tests/utils/*.test.js",
    "test:ui": "playwright test",
    "test:windows": "node --test tests/integration/windows.test.js",
    "test:windows-setup": "node --test tests/integration/windows-setup.test.js",
    "pretest:windows": "npm run build",
    "test:windows-update": "node --test tests/integration/windows-update.test.js",
    "pretest:windows-update": "npm run build",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "pretest:ui": "npm run build"
  },
  "engines": {
    "node": ">=22.18",
    "dsh": ">=0.2.0-rc.1"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.0.3"
  },
  "devDependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@playwright/test": "1.58.2",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semver": "^7.7.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/floatDreamWithSong/dsh-lifecycle.git"
  },
  "bin": {
    "dsh-lifecycle-reset": "scripts/reset.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
