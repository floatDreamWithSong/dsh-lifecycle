{
  "name": "dsh-lifecycle",
  "version": "0.1.4",
  "description": "Windows-inspired lock screen, persistent authentication and systemd lifecycle controls for DeepSeek Harness.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./dist/client.js",
    "./power": "./dist/host.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "types",
    "dist",
    "cordis.patch.yml",
    "scripts/install-systemd.mjs",
    "README.md",
    "docs",
    "LICENSE",
    "UPSTREAM-LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "scripts/reset.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js tests/lib/*.test.js tests/host/*.test.js tests/supervisor/*.test.js tests/utils/*.test.js",
    "test:ui": "playwright test",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "pretest:ui": "npm run build"
  },
  "engines": {
    "node": ">=22.18",
    "dsh": ">=0.2.0-rc.1"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.0.3"
  },
  "devDependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@playwright/test": "1.58.2",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semver": "^7.7.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/floatDreamWithSong/dsh-lifecycle.git"
  },
  "bin": {
    "dsh-lifecycle-reset": "scripts/reset.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
